{
	"name": "dovira/ga-telegram-bridge",
	"description": "Daily Google Analytics 4 report delivered to a Telegram chat.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"brain/monkey": "^2.7",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.2",
		"phpstan/phpstan": "^2.2",
		"phpunit/phpunit": "^12.5",
		"squizlabs/php_codesniffer": "^3.13",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"wp-coding-standards/wpcs": "^3.4"
	},
	"autoload-dev": {
		"psr-4": {
			"GaTelegramBridge\\": "src/",
			"GaTelegramBridge\\Tests\\": "tests/"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"platform": {
			"php": "8.3"
		},
		"sort-packages": true
	},
	"scripts": {
		"analyse": "phpstan analyse",
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"test": "phpunit"
	}
}
