<?xml version="1.0"?>
<ruleset name="ga-telegram-bridge">
	<description>WordPress Coding Standards for the Google Analytics to Telegram bridge plugin.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<!-- Throwaway spike probes (Sprint 1 Step 2): untracked and deleted at close. -->
	<exclude-pattern>/spike/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="parallel" value="8"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="7.1"/>

	<rule ref="WordPress">
		<!-- Classes follow PSR-4 (src/Plugin.php), not the WordPress class-*.php naming. -->
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="gatb"/>
				<element value="GaTelegramBridge"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="ga-telegram-bridge"/>
			</property>
		</properties>
	</rule>
</ruleset>
